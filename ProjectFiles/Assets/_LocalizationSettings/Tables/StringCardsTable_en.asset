  m_TableData:
  - m_Id: 101607587840
    m_Localized: Castle walls
    m_Metadata:
      m_Items: []
  - m_Id: 3105161265152
    m_Localized: "Builds fortress walls, <color=red>prohibiting the attack of units</color>
      <b>on this cell</b>. \n<i>Valid for 1 day.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 10614102081536
    m_Localized: Forbidden shield
    m_Metadata:
      m_Items: []
  - m_Id: 10719232311296
    m_Localized: "<b>Lower the Shield</b> onto the cage. <color=red>Blocks the setting
      of units</color>, gives <b><color=#005500>3 Protection</color></b>. \n<i>Valid
      for 1 day.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 12367849635840
    m_Localized: LightingBolt
    m_Metadata:
      m_Items: []
  - m_Id: 12482651930624
    m_Localized: '<b>Lightning</b> strikes <color=red>a cell</color>, <b>destroying
      a unit</b> on it.

      Attack power: <b><color=orange>3</color></b>.'
    m_Metadata:
      m_Items: []
  - m_Id: 13996447547392
    m_Localized: Meteor rain
    m_Metadata:
      m_Items: []
  - m_Id: 14078613962752
    m_Localized: "The area <b>4x4</b> is being hit by <b>5 meteorites</b>. Hit \u2014
      <color=red>destroy the unit</color>.\n<color=orange>Attack class 2</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 15076115922944
    m_Localized: Reprise
    m_Metadata:
      m_Items: []
  - m_Id: 15315635847168
    m_Localized: <b>The last cemetery card</b> goes into your <b> hand</b>.
    m_Metadata:
      m_Items: []
  - m_Id: 16798607523840
    m_Localized: Rock
    m_Metadata:
      m_Items: []
  - m_Id: 16966333546496
    m_Localized: 'To <b>an empty cell</b>. <color=red>Blocks: staging, attacking
      in/out of the cage</color>. <b>Lasts 2 days</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 19123539591168
    m_Localized: Sacrifice
    m_Metadata:
      m_Items: []
  - m_Id: 19262060675072
    m_Localized: "<b>Sacrifice</b> your unit on the field \u2014 it will be <color=red>killed</color>,
      and you will receive <b>one mana</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 1551844968579072
    m_Localized: Thief
    m_Metadata:
      m_Items: []
  - m_Id: 1551935880118272
    m_Localized: <b>Steals the chosen card</b> from opponent's hand to yours.
    m_Metadata:
      m_Items: []
  - m_Id: 2567380905050112
    m_Localized: Spy
    m_Metadata:
      m_Items: []
  - m_Id: 2567498580443136
    m_Localized: <b>Tells you about the selected opponent's card.</b>
    m_Metadata:
      m_Items: []
  - m_Id: 7247470494564352
    m_Localized: '<b>The player gets 1 mana in debt</b>.

      The debt will be
      <color=red>written off</color> as soon as possible in the <b>near future</b>.'
    m_Metadata:
      m_Items: []
  - m_Id: 7247461267095552
    m_Localized: The dept
    m_Metadata:
      m_Items: []
  - m_Id: 10621526212165632
    m_Localized: Rune stone
    m_Metadata:
      m_Items: []
  - m_Id: 10621701248860160
    m_Localized: "<b>Stone</b> (<i>1 day delay</i>) \u2192 <color=red>kill the unit</color>,
      then <color=red>block the attack and staging</color> for <b>1 day</b>.\nAttack
      power: <b><color=orange>4</color></b>."
    m_Metadata:
      m_Items: []
  - m_Id: 47109135167733760
    m_Localized: Reset
    m_Metadata:
      m_Items: []
  - m_Id: 47109241111658496
    m_Localized: <b>Resets <color=red>all</color></b> effects from the selected cell.
    m_Metadata:
      m_Items: []
  - m_Id: 93026169583648768
    m_Localized: King
    m_Metadata:
      m_Items: []
  - m_Id: 93026259702464512
    m_Localized: 'Replace the pawn with <b>Of the King</b>.

      <b>King</b>: attack
      <color=orange> on all neighboring cells</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 101487212966264832
    m_Localized: Knight
    m_Metadata:
      m_Items: []
  - m_Id: 101487284332347392
    m_Localized: 'Replace the pawn with <b>The horse</b>

      <b>Knight: Attack
      2 squares straight, and after 1 square sideways.Jumps over obstacles.'
    m_Metadata:
      m_Items: []
