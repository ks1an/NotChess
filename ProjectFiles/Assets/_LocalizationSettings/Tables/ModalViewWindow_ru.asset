  m_TableData:
  - m_Id: 18182908198912
    m_Localized: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 18342761512960
    m_Localized: "\u0421\u0435\u0442\u0435\u0432\u044B\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044B
      \u043D\u0435 \u0431\u044B\u043B\u0438 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u044B.
      \u0421\u0435\u0442\u0435\u0432\u0430\u044F \u0438\u0433\u0440\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0430.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0441\u0432\u043E\u0451
      \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18837630664704
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 20794218954752
    m_Localized: "\u0415\u0449\u0451 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 20898527100928
    m_Localized: "\u0422\u044B \u043F\u0440\u0430\u0432\u0434\u0430 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0432\u044B\u0439\u0442\u0438?\n\u041D\u043E \u0442\u044B \u0436\u0435 \u043E\u0431\u0435\u0449\u0430\u0435\u0448\u044C
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F?..."
    m_Metadata:
      m_Items: []
  - m_Id: 21305454280704
    m_Localized: "\u042F \u043E\u0441\u0442\u0430\u044E\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 21685923790848
    m_Localized: "\u042F \u0432\u0435\u0440\u043D\u0443\u0441\u044C...\u043A\u0445\u043C-\u043A\u0445\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 23866051706880
    m_Localized: "\u041C\u0443\u043B\u0438\u0433\u0430\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 24018250416128
    m_Localized: "\u0412\u044B \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0435
      <b>\u0432\u0441\u0435</b> \u043A\u0430\u0440\u0442\u044B \u0438\u0437 \u0432\u0430\u0448\u0435\u0439
      \u0440\u0443\u043A\u0438 \u0432 <b>\u043A\u043E\u043B\u043E\u0434\u0443</b>
      \u043A\u0440\u043E\u043C\u0435 \u043E\u0434\u043D\u043E\u0439. \u0415\u0451
      \u0443\u0431\u0438\u0440\u0430\u044E\u0442 \u0432 <b>\u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435</b>.\n
      \u0412\u0437\u0430\u043C\u0435\u043D, \u0432\u044B <b>\u0431\u0435\u0440\u0451\u0442\u0435
      \u043A\u0430\u0440\u0442\u044B \u0432 \u0440\u0443\u043A\u0443 \u0432 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435
      \u043D\u0430 \u043E\u0434\u043D\u0443 \u043C\u0435\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0443 \u0432\u0430\u0441 \u0431\u044B\u043B\u043E \u0432
      \u0440\u0443\u043A\u0435</b>, \u043D\u043E \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435
      \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25078855680000
    m_Localized: "\u041D\u0435 \u0445\u043E\u0447\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25154940354560
    m_Localized: "\u0414\u0435\u043B\u0430\u0435\u043C.\n\u041C\u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 27486008688640
    m_Localized: "\u0420\u0435\u0432\u0430\u043D\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 27584901988352
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
      \u0440\u0435\u0432\u0430\u043D\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 27792880746496
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u0440\u0435\u0432\u0430\u043D\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 27827215319040
    m_Localized: "\u041D\u0435, \u043E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28376690114560
    m_Localized: "\u0420\u0435\u0441\u0442\u0430\u0440\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 28507418181632
    m_Localized: "\u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u043D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E
      \u043C\u0430\u0442\u0447?"
    m_Metadata:
      m_Items: []
  - m_Id: 28638024613888
    m_Localized: "\u041F\u0435\u0440\u0435\u0438\u0433\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28663043637248
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30888419704832
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0432 \u043C\u0435\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 31001846267904
    m_Localized: "\u0412\u044B \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E \u0445\u043E\u0442\u0438\u0442\u0435
      \u0432\u044B\u0439\u0442\u0438 \u0432 \u043C\u0435\u043D\u044E? \u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
      \u044D\u0442\u043E \u043D\u0435 \u043E\u0446\u0435\u043D\u0438\u0442. \u042F
      \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31262950080512
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31298584887296
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 299173354717184
    m_Localized: "\u0425\u043E\u0441\u0442 \u0443\u0448\u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 299259388280832
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u044B\u0431\u043E\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 299382520463360
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 299453274177536
    m_Localized: "\u0418\u0433\u0440\u043E\u043A \u0441\u0431\u0435\u0436\u0430\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 299559511703552
    m_Localized: "\u0422\u044B \u0441\u0434\u0435\u043B\u0430\u043B \u0435\u0433\u043E
      \u0438 \u043E\u043D \u0441\u0431\u0435\u0436\u0430\u043B. \u0410\u0436 \u043F\u044F\u0442\u043A\u0438
      \u0441\u0432\u0435\u0440\u043A\u0430\u043B\u0438! \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u0432 \u043C\u0435\u043D\u044E,
      \u0441\u0442\u0440\u0430\u0442\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 299853607911424
    m_Localized: "\u0411\u0423-\u0425\u0410-\u0425\u0410-\u0425\u0410."
    m_Metadata:
      m_Items: []
  - m_Id: 299969362313216
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 300051054772224
    m_Localized: "\u041B\u043E\u0431\u0431\u0438 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 300138048831488
    m_Localized: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u043D\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u043A\u043E\u043C\u043D\u0430\u0442,
      \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
      \u0432\u0430\u0448\u0438\u043C \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 300421512478720
    m_Localized: "\u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 300490412310528
    m_Localized: "\u0420\u0435\u0432\u0430\u043D\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 300599304830976
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0440\u0435\u0432\u0430\u043D\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 300748265537536
    m_Localized: "\u041F\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 300822777348096
    m_Localized: "\u0420\u0435\u0432\u0430\u043D\u0448. \u042F \u0432\u044B\u0438\u0433\u0440\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 300982806822912
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 301155595370496
    m_Localized: "\u0412\u044B\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 301159747731456
    m_Localized: "\u0420\u0435\u0432\u0430\u043D\u0448! \u042F \u043E\u0442\u044B\u0433\u0440\u0430\u044E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 303724367495168
    m_Localized: "\u0412\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 303811726458880
    m_Localized: "\u041C\u043E\u0438 \u0430\u043F\u043B\u043E\u0434\u0438\u0441\u043C\u0435\u043D\u0442\u044B.
      \u0425\u043E\u0442\u0438\u0442\u0435 \u0441\u0440\u0430\u0437\u0438\u0442\u044C\u0441\u044F
      \u0441 \u044D\u0442\u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C
      \u0435\u0449\u0451 \u0440\u0430\u0437?"
    m_Metadata:
      m_Items: []
  - m_Id: 304166489079808
    m_Localized: "\u0415\u0449\u0451 \u0438\u0433\u0440\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 304269270499328
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 301105259528192
    m_Localized: "\u041C\u043D\u0435 \u0436\u0430\u043B\u044C. \u041C\u043E\u0436\u0435\u0442
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u043E\u0442\u044B\u0433\u0440\u0430\u0442\u044C\u0441\u044F?
      \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438 \u0440\u0435\u0432\u0430\u043D\u0448
      \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0443!"
    m_Metadata:
      m_Items: []
