    m_Metadata:
      m_Items: []
  - m_Id: 7247461267095552
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 7247470494564352
    m_Localized: "\u0412\u044B <b>\u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      <#118a7e>2</color> \u043C\u0430\u043D\u044B</b> \u0438 \u043E\u0431\u044F\u0437\u0443\u0435\u0442\u0435\u0441\u044C
      <b>\u0432\u0435\u0440\u043D\u0443\u0442\u044C <#118a7e>3</color></b> \u043C\u0430\u043D\u044B 
      <b><color=\"red>\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u043E \u0445\u043E\u0434\u0430</color>.
      \u042D\u0442\u043E\u0442 \u0434\u043E\u043B\u0433 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043D\u043E
      \u043F\u0440\u043E\u0449\u0435\u043D."
