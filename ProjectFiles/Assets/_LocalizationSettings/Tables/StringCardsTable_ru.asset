  - m_Id: 12367849635840
    m_Localized: "\u0423\u0434\u0430\u0440 \u043C\u043E\u043B\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12482651930624
    m_Localized: " \u0411\u044C\u0451\u0442 \u043F\u043E \u043A\u043B\u0435\u0442\u043A\u0435.
      <b><#ff0000>\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442</color>
      \u044E\u043D\u0438\u0442\u0430</b>  \u043D\u0430 \u044D\u0442\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 13996447547392
    m_Localized: "\u041C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u044B\u0439
      \u0434\u043E\u0436\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 14078613962752
    m_Localized: "<b>\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435 5</b>
      \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043E\u0432 <b><#ff0000>\u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u044E\u0442</color>
      \u044E\u043D\u0438\u0442\u043E\u0432</b> \u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 15076115922944
    m_Localized: "\u0412\u043E\u0441\u043A\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 15315635847168
    m_Localized: "<b><#118a7e>\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442</color>
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u0443\u044E</b>
      \u043A\u0430\u0440\u0442\u0443 \u0432 \u0440\u0443\u043A\u0443.\n<b>\u041C\u043E\u0436\u0435\u0442
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C \u044D\u0442\u0443
      \u0436\u0435 \u043A\u0430\u0440\u0442!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 16798607523840
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 16966333546496
    m_Localized: "<#005500><b>\u0411\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443</b> \u044E\u043D\u0438\u0442\u0430</color>
      \u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0443 \u043D\u0430 <b>2 \u0440\u0430\u0443\u043D\u0434\u0430</b>.
      \n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      <b>\u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u043A\u043B\u0435\u0442\u043A\u0430\u0445</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 19123539591168
    m_Localized: "\u0416\u0435\u0440\u0442\u0432\u043E\u043F\u0440\u0438\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19262060675072
    m_Localized: "\u0412\u044B <b><color=\"red\">\u0436\u0435\u0440\u0442\u0432\u0443\u0435\u0442\u0435</color></b>
      \u0432\u0430\u0448\u0435\u0433\u043E <color=\"red\">\u044E\u043D\u0438\u0442\u0430</color>
      \r\n\u0438 <b>\u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 <#0000FF>2</b>
      \u043C\u0430\u043D\u044B</color> \u0432\u0437\u0430\u043C\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1551844968579072
    m_Localized: "\u041A\u0430\u0440\u043C\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1551935880118272
    m_Localized: "<b>\u041A\u0440\u0430\u0434\u0435\u0442</b> \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u043A\u0430\u0440\u0442\u0443 <b>\u0438\u0437 \u0440\u0443\u043A\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430</b>
      \u0438 \u043A\u043B\u0430\u0434\u0435\u0442 \u0435\u0435 \u0432\u0430\u043C
      \u0432 \u0440\u0443\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2567380905050112
    m_Localized: "\u0428\u043F\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2567498580443136
    m_Localized: "<b>\u0414\u0430\u0451\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E</b>
