  m_TableData:
  - m_Id: 101607587840
    m_Localized: "\u041A\u0440\u0435\u043F\u043E\u0441\u0442\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3105161265152
    m_Localized: "\u0412\u043E\u0437\u0432\u043E\u0434\u0438\u0442 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u043D\u044B\u0435
      \u0441\u0442\u0435\u043D\u044B, <color=red>\u0437\u0430\u043F\u0440\u0435\u0449\u0430\u044F
      \u0430\u0442\u0430\u043A\u0443 \u044E\u043D\u0438\u0442\u0430\u043C\u0438</color>
      <b>\u043D\u0430 \u044D\u0442\u0443 \u043A\u043B\u0435\u0442\u043A\u0443</b>.
      \n<i>\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 1 \u0434\u0435\u043D\u044C.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 10614102081536
    m_Localized: "\u0417\u0430\u043F\u0440\u0435\u0442\u043D\u044B\u0439 \u0449\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10719232311296
    m_Localized: "<b>\u041E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0429\u0438\u0442</b>
      \u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0443. <color=red>\u0411\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u044E\u043D\u0438\u0442\u043E\u0432</color>,
      \u0434\u0430\u0451\u0442 <b><color=#005500>\u0417\u0430\u0449\u0438\u0442\u0443
      3</color></b>.\n<i>\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 1
      \u0434\u0435\u043D\u044C.</i>"
    m_Metadata:
      m_Items: []
  - m_Id: 12367849635840
    m_Localized: "\u0423\u0434\u0430\u0440 \u043C\u043E\u043B\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12482651930624
    m_Localized: "<b>\u041C\u043E\u043B\u043D\u0438\u044F</b> \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      <color=red>\u0443\u0434\u0430\u0440 \u043F\u043E \u043A\u043B\u0435\u0442\u043A\u0435</color>,
      <b>\u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u044F \u044E\u043D\u0438\u0442\u0430</b>
      \u043D\u0430 \u043D\u0435\u0439.\r\n\u0421\u0438\u043B\u0430 \u0430\u0442\u0430\u043A\u0438:
      <b><color=orange>3</color></b>."
    m_Metadata:
      m_Items: []
  - m_Id: 13996447547392
    m_Localized: "\u041C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u044B\u0439
      \u0434\u043E\u0436\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 14078613962752
    m_Localized: "\u041D\u0430 \u043E\u0431\u043B\u0430\u0441\u0442\u044C <b>4\xD74</b>
      \u043F\u0430\u0434\u0430\u0435\u0442 <b>5 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043E\u0432</b>.
      \u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u2014 <color=red>\u0443\u043D\u0438\u0447\u0442\u043E\u0436\u044C\u0442\u0435
      \u044E\u043D\u0438\u0442\u0430</color>.\n<color=orange>\u041A\u043B\u0430\u0441\u0441
      \u0430\u0442\u0430\u043A\u0438 2</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 15076115922944
    m_Localized: "\u0420\u0435\u043F\u0440\u0438\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15315635847168
    m_Localized: "<b>\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043A\u0430\u0440\u0442\u0430
      \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0430</b> \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0432\u0430\u043C \u0432 <b>\u0440\u0443\u043A\u0443</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 16798607523840
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 16966333546496
    m_Localized: "\u041D\u0430 <b>\u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E
      \u043A\u043B\u0435\u0442\u043A\u0443</b>. <color=red>\u0411\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442:
      \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443, \u0430\u0442\u0430\u043A\u0443
      \u0432/\u0438\u0437 \u043A\u043B\u0435\u0442\u043A\u0438</color>. <b>\u0414\u043B\u0438\u0442\u0441\u044F
      2 \u0434\u043D\u044F</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 19123539591168
    m_Localized: "\u0416\u0435\u0440\u0442\u0432\u043E\u043F\u0440\u0438\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19262060675072
    m_Localized: "<b>\u041F\u043E\u0436\u0435\u0440\u0442\u0432\u0443\u0439\u0442\u0435</b>
      \u0441\u0432\u043E\u0435\u0433\u043E \u044E\u043D\u0438\u0442\u0430 \u043D\u0430
      \u043F\u043E\u043B\u0435 \u2014 \u043E\u043D \u0431\u0443\u0434\u0435\u0442
      <color=red>\u0443\u0431\u0438\u0442</color>, \u0430 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      <b>\u043E\u0434\u043D\u0443 \u043C\u0430\u043D\u0443</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 1551844968579072
    m_Localized: "\u0412\u043E\u0440\u0438\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1551935880118272
    m_Localized: "<b>\u041A\u0440\u0430\u0434\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E
      \u043A\u0430\u0440\u0442\u0443</b> \u0438\u0437 \u0440\u0443\u043A\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u0432 \u0441\u0432\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2567380905050112
    m_Localized: "\u0428\u043F\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2567498580443136
    m_Localized: "<b>\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043F\u0440\u043E \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0443
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 7247461267095552
    m_Localized: "\u0414\u043E\u043B\u0436\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 7247470494564352
    m_Localized: "<b>\u0418\u0433\u0440\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      1 \u043C\u0430\u043D\u0443 \u0432 \u0434\u043E\u043B\u0433</b>.\r\n\u0414\u043E\u043B\u0433
      \u0431\u0443\u0434\u0435\u0442 <color=red>\u0441\u043F\u0438\u0441\u0430\u043D</color>
      \u043F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u0439 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
      \u0432 <b>\u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u0445\u043E\u0434\u0435</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 10621526212165632
    m_Localized: "\u0420\u0443\u043D\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10621701248860160
    m_Localized: "<b>\u041A\u0430\u043C\u0435\u043D\u044C</b> (<i>\u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430
      1 \u0434\u0435\u043D\u044C</i>) \u2192 <color=red>\u0443\u0431\u0438\u0442\u044C
      \u044E\u043D\u0438\u0442\u0430</color>, \u0437\u0430\u0442\u0435\u043C <color=red>\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0430\u0442\u0430\u043A\u0443 \u0438 \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443</color>
      \u043D\u0430 <b>1 \u0434\u0435\u043D\u044C</b>.\n\u041A\u043B\u0430\u0441\u0441
      \u0430\u0442\u0430\u043A\u0438: <b><color=orange>4</color></b>."
    m_Metadata:
      m_Items: []
  - m_Id: 47109135167733760
    m_Localized: "\u041E\u0431\u043D\u0443\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 47109241111658496
    m_Localized: "<b>\u0421\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      <color=red>\u0432\u0441\u0435</color></b> \u044D\u0444\u0444\u0435\u043A\u0442\u044B
      \u0441 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 93026169583648768
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 93026259702464512
    m_Localized: "\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u0435 \u043F\u0435\u0448\u043A\u0443
      \u043D\u0430 <b>\u041A\u043E\u0440\u043E\u043B\u044F</b>\r.\n<b>\u041A\u043E\u0440\u043E\u043B\u044C</b>:
      \u0430\u0442\u0430\u043A\u0430 <color=orange>\u0432\u043E \u0432\u0441\u0435
      \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u043A\u043B\u0435\u0442\u043A\u0438</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101487212966264832
    m_Localized: "\u041A\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 101487284332347392
    m_Localized: "\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u0435 \u043F\u0435\u0448\u043A\u0443
      \u043D\u0430 <b>\u041A\u043E\u043D\u044F</b>\r\n<b>\u041A\u043E\u043D\u044C</b>:
      \u0430\u0442\u0430\u043A\u0430 \u043D\u0430 2 \u043A\u043B\u0435\u0442\u043A\u0438
      \u043F\u0440\u044F\u043C\u043E, \u0430 \u043F\u043E\u0441\u043B\u0435 1 \u0432\u0431\u043E\u043A.\u041F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0442
      \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
