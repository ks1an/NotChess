      m_Items: []
  - m_Id: 8516488708096
    m_Localized: "\u0417\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u044E \u0446\u0435\u043C\u0435\u043D\u0442
      \u0434\u043B\u044F \u043F\u043E\u043B\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 8808546484224
    m_Localized: "\u0421\u043E\u0440\u0442\u0438\u0440\u0443\u044E \u043A\u0440\u0435\u0441\u0442\u0438\u043A\u0438
      \u0438 \u043D\u043E\u043B\u0438\u043A\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 8883817463808
    m_Localized: "\u0424\u0438\u0433\u0443\u0440\u044B \u043D\u0430 \u0437\u0435\u043B\u0435\u043D\u043E\u043C
      \u043F\u043E\u043B\u0435 \u0442\u0440\u043E\u0433\u0430\u044E\u0442 \u0442\u0440\u0430\u0432\u0443,
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u0430\u043C "
    m_Metadata:
      m_Items: []
  - m_Id: 8969700032512
    m_Localized: "\u0420\u0438\u0441\u0443\u044E \u043A\u0430\u0440\u0442\u044B "
    m_Metadata:
      m_Items: []
  - m_Id: 9089610989568
    m_Localized: "\u0420\u0438\u0441\u0443\u044E \u043A\u0440\u0435\u0441\u0442\u0438\u043A\u0438
      \u043D\u0430 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 9182296719360
    m_Localized: "\u0415\u0441\u043B\u0438 \u043D\u0430\u0448\u043B\u0438 \u0431\u0430\u0433
      \u2013 \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u0435, \u044F \u043D\u0430\u043F\u0438\u0448\u0443
      \u043E\u0442\u0447\u0435\u0442 \u0438 \u044D\u0442\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
      \u043B\u0438\u043D\u0438\u044F \u0431\u0443\u0434\u0435\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 9503290998784
    m_Localized: "\u0414\u043B\u044F \u043F\u043E\u0431\u0435\u0434\u044B \u043D\u0443\u0436\u043D\u043E
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043B\u0438\u043D\u0438\u044E \u0438\u0437
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0444\u0438\u0433\u0443\u0440
      \u043D\u0430 \u0434\u043E\u0441\u043A\u0435. \n\u0414\u043E\u0441\u043A\u0443
      \u044F \u0434\u0430\u043C, \u0444\u0438\u0433\u0443\u0440, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0442\u043E\u0436\u0435. \u041A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044E
      \u043D\u0435 \u0434\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 9737916170240
    m_Localized: "\u041A\u0430\u0440\u0442\u044B \u0442\u0440\u0430\u0442\u044F\u0442
      \u043C\u0430\u043D\u0443, \u0435\u0451 \u044F \u043D\u0435 \u0434\u0430\u043C "
    m_Metadata:
      m_Items: []
  - m_Id: 9856954712064
    m_Localized: "\u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E \u043F\u043E\u043B\u0435 "
    m_Metadata:
      m_Items: []
  - m_Id: 9929159655424
    m_Localized: "\u0420\u0430\u0441\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u044E
      \u0444\u0438\u0433\u0443\u0440\u044B "
    m_Metadata:
      m_Items: []
  - m_Id: 10043643183104
    m_Localized: "\u042F \u043C\u043E\u0433\u0443 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u0447\u0442\u043E-\u0442\u043E \u0443\u043C\u043D\u043E\u0435, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440\u2026...
      \u043B\u0430\u0434\u043D\u043E, \u0438 \u0442\u0430\u043A \u0441\u043E\u0439\u0434\u0435\u0442.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043B\u0438\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10224132472832
    m_Localized: "\u0420\u0438\u0441\u0443\u044E \u0435\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u043E\u0432..."
    m_Metadata:
      m_Items: []
  - m_Id: 11045142315008
    m_Localized: "\u041E\u0431\u0443\u0447\u0430\u044E \u0444\u0438\u0433\u0443\u0440\u044B
      \u0445\u043E\u0434\u0438\u0442\u044C "
    m_Metadata:
      m_Items: []
  - m_Id: 11891376701440
    m_Localized: "\u041F\u043E\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u043F\u0430\u043B\u043A\u0438
      \u043F\u043E\u0434 \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u041E\u043D\u0438
      \u043D\u0435 \u0443\u043F\u0430\u0434\u0443\u0442..?"
    m_Metadata:
      m_Items: []
  - m_Id: 12021760835584
    m_Localized: "\u0427\u0442\u043E \u0435\u0441\u043B\u0438 \u043A\u0430\u043C\u043D\u0438
      \u043C\u044F\u0433\u043A\u0438\u0435, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0432\u0435\u0440\u0434\u0435\u044E\u0442 \u043F\u0440\u0438 \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u0438? "
    m_Metadata:
      m_Items: []
  - m_Id: 12655474032640
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u044F\u044E \u0440\u0430\u0431\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 14600037253120
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u0448\u0443\u0442\u043A\u0438
      \u0432 \u0438\u043D\u044B\u0445 \u0432\u0435\u0440\u0441\u0438\u043E\u043D\u043D\u044B\u0445
      \u043B\u0438\u043D\u0438\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 14918389121024
    m_Localized: "\u0417\u0430\u043A\u0443\u043F\u0430\u044E \u043A\u043E\u0441\u0442\u044B\u043B\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 15049826025472
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u044B \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0438
      \u2018\u043D\u0435\u2019 \u043A \u0448\u0430\u0445\u043C\u0430\u0442\u0430\u043C
      \u0438 \u043D\u0438\u0447\u0435\u0433\u043E \u0438\u0437 \u043D\u0438\u0445
      \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C?  "
    m_Metadata:
      m_Items: []
  - m_Id: 15122744000512
    m_Localized: "\u0410 \u0432\u043E\u0442 \u0432 \u0441\u0442\u0430\u0440\u044B\u0445
      \u0432\u0435\u0440\u0441\u0438\u043E\u043D\u043D\u044B\u0445 \u043B\u0438\u043D\u0438\u044F\u0445..
      \u042D\u0445..."
    m_Metadata:
      m_Items: []
  - m_Id: 15329229586432
    m_Localized: "\u0412\u044B \u0437\u043D\u0430\u0435\u0442\u0435 \u043E \u0432\u0430\u0436\u043D\u043E\u043C
      \u043F\u0440\u0430\u0432\u0438\u043B\u0435 \u0438\u0433\u0440\u044B? \u041A\u0430\u043A
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0435\u0442\u0435 \u2013 \u043F\u0438\u0448\u0438\u0442\u0435 "
    m_Metadata:
      m_Items: []
  - m_Id: 15434359816192
    m_Localized: "\u041C\u044B \u0435\u0441\u0442\u044C, \u0430 \u0442\u044B? "
    m_Metadata:
      m_Items: []
  - m_Id: 15525845975040
    m_Localized: "\u041F\u0440\u044B\u0433\u0430\u0442\u044C \u043F\u043E\u0434 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B
      \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E. \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043E\u0448\u0438\u0431\u043E\u043A \u043B\u0438\u043D\u0438\u0438 \u0437\u0430
      \u0432\u0430\u0448 \u0441\u0447\u0435\u0442 :)"
    m_Metadata:
      m_Items: []
  - m_Id: 15782881312768
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F \u0431\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u044F \u0433\u043E\u0432\u043E\u0440\u044E \u0437\u0430\u043F\u0440\u0435\u0442\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430. \u0415\u0441\u043B\u0438 \u0432\u044B \u0440\u0430\u043D\u0438\u043C\u044B...
      \u041D\u0443, \u043D\u0435 \u0431\u0443\u0434\u0435\u043C \u043E \u0433\u0440\u0443\u0441\u0442\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 16284905947136
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u0441\u0435\u043B\u0435\u043D\u043D\u0430\u044F
      \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u0430, \u0442\u043E
      \u0432 \u043D\u0435\u0439 \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F
      \u043A\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u043C\u0438
      \u043D\u0430\u0436\u0430\u0442\u0438\u044F\u043C\u0438 \u043F\u043E \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435
      \u0441\u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u0438\u0433\u0440\u0443, \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 16363402346496
    m_Localized: "\u0414\u043B\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u043A\u043C\u2026 \u043E\u0439,
      \u043D\u0435 \u0432 \u0442\u043E\u0442 \u0430\u0442\u0442\u0440\u0430\u043A\u0442\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 16675299180544
    m_Localized: "-\u042F \u0441\u0434\u0435\u043B\u0430\u043B \u0438\u0433\u0440\u0443!
      \n-\u0410 \u044F \u043D\u0435\u0442. \n-\u0422\u044B \u043A\u0442\u043E \u0442\u0430\u043A\u043E\u0439!?"
    m_Metadata:
      m_Items: []
  - m_Id: 16970200694784
    m_Localized: "\u0427\u0442\u043E \u0432\u044B \u0434\u0435\u043B\u0430\u0435\u0442\u0435
      \u043D\u0430 \u043C\u043E\u0435\u043C \u0434\u0438\u0441\u043A\u0435?  "
    m_Metadata:
      m_Items: []
  - m_Id: 17119748603904
    m_Localized: "\u0418\u0433\u0440\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F,
      \u044F \u043F\u044C\u044E \u0447\u0430\u0439 "
    m_Metadata:
      m_Items: []
  - m_Id: 17201810161664
    m_Localized: "\u2013\u0422\u0430\u043A,\u043A\u0442\u043E \u0442\u044B? \n\u2013\u0410
      \u044D\u0442\u043E \u0442\u0430\u043A \u0432\u0430\u0436\u043D\u043E?\n\u2013\u0415\u0441\u043B\u0438
      \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043E\u0432\u0441\u044F\u043D\u043E\u0435
      \u043F\u0435\u0447\u0435\u043D\u044C\u0435 \u043A \u043C\u043E\u0435\u043C\u0443
      \u0447\u0430\u044E, \u0442\u043E \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 17457364910080
    m_Localized: "-\u0414\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u043C\u044B
      \u043F\u043E\u043B\u0430\u0434\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 17578232168448
    m_Localized: "\u0422\u0430\u0441\u0443\u044E \u043A\u043E\u043B\u043E\u0434\u0443 "
    m_Metadata:
      m_Items: []
  - m_Id: 17958068338688
    m_Localized: "\u042D\u043C\u2026 \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442
      \u044D\u0442\u0430 \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430? "
    m_Metadata:
      m_Items: []
  - m_Id: 18040746459136
    m_Localized: "\u0412\u0435\u0434\u0443\u0449\u0438\u0439 \u0441\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0435\u0434\u0443, \u043E\u0436\u0438\u0434\u0430\u0439\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19562683219968
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u043A\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 19643977220096
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432..."
    m_Metadata:
      m_Items: []
  - m_Id: 19808523960320
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u044E\u0441\u044C
      \u043A \u0432\u044B\u0441\u0448\u0435\u043C\u0443 \u0440\u0430\u0437\u0443\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 19885804011520
    m_Localized: "\u0411\u0438\u0438\u0438\u0438\u043F \u0431\u0438\u0438\u043F!"
    m_Metadata:
      m_Items: []
  - m_Id: 19945778364416
    m_Localized: "\u0414\u0435\u043B\u0430\u044E \u0441\u0432\u043E\u0439 \u0445\u043E\u0434..."
    m_Metadata:
      m_Items: []
  - m_Id: 20019270959104
    m_Localized: "\u042F \u0442\u0443\u0442 \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u043B
      \u043E \u0447\u0435\u043C-\u0442\u043E \u0432\u0430\u0436\u043D\u043E\u043C.
      \u0418 \u0432\u043E\u0442 \u043A \u0447\u0435\u043C\u0443 \u043F\u0440\u0438\u0448\u0435\u043B.
      \u0427\u0442\u043E \u0435\u0441\u043B\u0438 \u043C\u044B \u0432\u043E\u0437\u044C\u043C\u0451\u043C
      \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0438 \u0434\u043E\u0431\u0430\u0432\u0438\u043C \u043A \u043D\u0435\u043C\u0443
      \"Not\" \u0432 \u043D\u0430\u0447\u0430\u043B\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 20356178427904
    m_Localized: "\u042F \u043C\u043E\u0433\u0443...\u041F\u043E\u0436\u0435\u043B\u0430\u0442\u044C
      \u0432\u0430\u043C \u0443\u0434\u0430\u0447\u0438.\n\u0414\u0430, \u0442\u0430\u043A
      \u0438 \u0441\u0434\u0435\u043B\u0430\u044E. \u0423\u0434\u0430\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 20667945238528
    m_Localized: "\u041D\u043E \u0432 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0439
      \u0432\u0435\u0440\u0441\u0438\u0438 \u0431\u044B\u043B\u043E \u043B\u0443\u0447\u0448\u0435...
      \u0418\u043B\u0438 \u043D\u0435\u0442? \u0427\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C?"
