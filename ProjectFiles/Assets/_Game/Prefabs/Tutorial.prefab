  steps:
  - type: 0
    message: "\u0421\u043E\u0431\u0435\u0440\u0438 5 \u0441\u0432\u043E\u0438\u0445
      \u043F\u0435\u0448\u0435\u043A \u0432 \u0440\u044F\u0434 \u2014 \u0438 \u043F\u043E\u0431\u0435\u0434\u0438\u0448\u044C.
      \u0412\u0440\u0430\u0433\u0443 \u043D\u0443\u0436\u043D\u043E \u0442\u043E
      \u0436\u0435 \u0441\u0430\u043C\u043E\u0435. \u0421\u0435\u0439\u0447\u0430\u0441
      \u0443\u0432\u0438\u0434\u0438\u0448\u044C, \u043A\u0430\u043A \u044D\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    targetTiles: []
    playCardType: {fileID: 0}
    delayBeforeWork: 0
  - type: 0
    message: "\u0421\u043C\u043E\u0442\u0440\u0438: \u0443 \u0432\u0440\u0430\u0433\u0430
      2 \u0432 \u0440\u044F\u0434. \u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0442\u0440\u0435\u0442\u044C\u044E \u2014 \u0438 \u0442\u043E\u0433\u0434\u0430
      \u043E\u043D \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0441\u044F
      \u043A \u043F\u043E\u0431\u0435\u0434\u0435"
    targetTiles: []
    playCardType: {fileID: 0}
    delayBeforeWork: 0
  - type: 1
    message: 
    targetTiles:
    - {x: 4, y: 2}
    playCardType: {fileID: 0}
    delayBeforeWork: 0
  - type: 4
    message: "\u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439 \u0435\u0433\u043E
      \u043B\u0438\u043D\u0438\u044E! \u0422\u0430\u043F\u043D\u0438 \u043F\u043E
      \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0435."
    targetTiles:
    - {x: 5, y: 2}
    playCardType: {fileID: 0}
    delayBeforeWork: 1.25
  - type: 2
    message: 
    targetTiles:
    - {x: 1, y: 2}
    playCardType: {fileID: 510541827946207621, guid: d0593010e7083154ab61f53b41a80116, type: 3}
    delayBeforeWork: 0
  - type: 1
    message: "\u041D\u0430 \u043D\u043E\u0441\u0443 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435!"
    targetTiles:
    - {x: 4, y: 1}
    - {x: 5, y: 2}
    playCardType: {fileID: 0}
    delayBeforeWork: 0.5
  - type: 3
    message: "\u041F\u0440\u0435\u0440\u0432\u0438 \u043B\u0438\u043D\u0438\u044E,
      \u0443\u0434\u0430\u0440\u044C \u043F\u043E \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u043E\u0439
      \u043A\u043B\u0435\u0442\u043A\u0435 \u043A\u0430\u0440\u0442\u043E\u0439 \"\u0423\u0434\u0430\u0440
      \u043C\u043E\u043B\u043D\u0438\u0438\""
    targetTiles:
