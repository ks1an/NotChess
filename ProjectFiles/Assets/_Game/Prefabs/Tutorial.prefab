    delayBeforeWork: 1.25
  - type: 5
    message: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438
      \u0441\u0432\u043E\u044E \u043F\u0435\u0448\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
